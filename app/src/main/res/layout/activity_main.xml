<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="12dp">

    <!-- أزرار التحكم بالاتصال -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnScanQr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="مسح QR للإقران"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="اتصال سريع"
            android:backgroundTint="#43A047"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- أزرار الأوامر السريعة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnReadInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Read Info"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnRebootRecovery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reboot Recovery"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp"/>
    </LinearLayout>

    <!-- نافذة عرض الـ Log والنتائج -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> HHuMMeRR adb جاهز للاتصال...\n"
            android:textColor="#00FF66"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textIsSelectable="true"/>
    </ScrollView>

    <!-- شريط كتابة الأوامر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="اكتب أمر ADB هنا (مثل: pm list packages)"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="#1E1E1E"
            android:padding="12dp"
            android:singleLine="true"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="إرسال"
            android:backgroundTint="#FB8C00"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
